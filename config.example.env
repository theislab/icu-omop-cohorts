# The paths and cluster settings of this checkout. Copy this file to config.env (gitignored) and fill in what you use;
# env.sh reads it, and every script and job of the repository runs after env.sh. A variable that is already set in the
# environment keeps its value (the ${VAR:-...} form), so a job keeps what its submitter passed.

# The OMOP CDM that the cohort builder reads, a folder with a Parquet file per table, e.g. <out_dir>/cdm of omop_etl.
# The notebook reads it too; unset, the notebook reads demo/omop/cdm_mimic4, which `ci/demo.sh demo` builds.
# export OMOP_CDM=${OMOP_CDM:-/path/to/omop-etl-output/cdm}

# The config of omop_etl (default omop_etl/config.local.yaml, copied from omop_etl/config.example.yaml)
# export OMOP_ETL_CONFIG=${OMOP_ETL_CONFIG:-/path/to/omop_etl-config.yaml}

# omop_etl/tools/run_cohorts.sh refuses outputs outside this directory, e.g. outside where your data use agreement
# allows patient-derived data
# export ICU_OMOP_DATA=${ICU_OMOP_DATA:-/path/to/processed_data}

# SLURM: the partition and QOS of every job; sbatch reads these variables itself
# export SBATCH_PARTITION=${SBATCH_PARTITION:-cpu}
# export SBATCH_QOS=${SBATCH_QOS:-normal}

# Tests: the MIMIC-IV demo (test_mimic4_demo.py), an Athena download in place of the vocabulary fixture, and ricu's
# concept dictionaries (test_crosswalk.py): the installed ricu R package and ricu-extensions/configs of YAIB-cohorts.
# Each test skips without its data.
# export MIMIC_IV_DEMO=${MIMIC_IV_DEMO:-/path/to/mimic-iv-demo/2.2}
# export OMOP_VOCABULARY=${OMOP_VOCABULARY:-/path/to/athena-vocabulary}
# export RICU_LIB_PATH=${RICU_LIB_PATH:-/path/to/R/library/ricu}
# export RICU_EXTENSIONS=${RICU_EXTENSIONS:-/path/to/YAIB-cohorts/ricu-extensions/configs}

# uv: the environment and the caches (default .venv and uv's own cache), e.g. on a fast local disk
# export UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT:-/local/disk/venvs/icu-omop-cohorts}
# export UV_CACHE_DIR=${UV_CACHE_DIR:-/local/disk/uv-cache}
